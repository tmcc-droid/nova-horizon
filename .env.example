# Copy to .env and adjust as needed.
#   copy .env.example .env

# --- Postgres (docker-compose) ---
POSTGRES_USER=nova
POSTGRES_PASSWORD=nova
POSTGRES_DB=nova_horizon
POSTGRES_PORT=5432
DATABASE_URL=postgres://nova:nova@127.0.0.1:5432/nova_horizon

# --- Redis (optional; only with: docker compose --profile redis up -d) ---
REDIS_PORT=6379
# REDIS_URL=redis://127.0.0.1:6379

# --- game-server ---
BIND_ADDR=0.0.0.0:8080
CONTENT_VERSION=0.1.0-dev
JWT_ACCESS_SECRET=change-me-in-production-use-long-random
SESSION_TTL_HOURS=72
RUST_LOG=info,game_server=debug,sim=debug
